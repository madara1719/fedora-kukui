KERNEL_CMDLINE="cros_secure console=tty1 root=PARTUUID=%U/PARTNROFF=3 rootwait ro fsck.fix=yes fsck.repair=yes net.ifnames=0 ipv6.disable=1 noresume apparmor= systemd.gpt_auto=0"
